# Template for the SNMPv3 credentials of ONE device. Copy it to config/snmp.env (git-ignored),
# fill in the real values, and load it into your shell before starting netmonlt. NetMonLT reads
# credentials only from environment variables; it never reads them from the inventory file, and
# it does not load this file by itself. Never commit real credentials.
#
# The variable names start with the `credentials_env` prefix from the inventory (here
# NETMONLT_SNMP_HOME_ROUTER). Keys must be at least 8 characters.
#
#   Linux / macOS:   set -a; . config/snmp.env; set +a
#   PowerShell:      Get-Content config\snmp.env | ForEach-Object {
#                      if ($_ -match '^\s*([A-Z0-9_]+)=(.*)$') { Set-Item "env:$($Matches[1])" $Matches[2] } }
NETMONLT_SNMP_HOME_ROUTER_USER=replace-with-the-snmpv3-user
NETMONLT_SNMP_HOME_ROUTER_AUTH_KEY=replace-with-the-authentication-passphrase
NETMONLT_SNMP_HOME_ROUTER_PRIV_KEY=replace-with-the-privacy-passphrase
